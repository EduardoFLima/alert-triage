# Connection: where the platform is, how to authenticate, and where reports go.
#
# Copy to `.env`, fill in the values, and keep it out of version control —
# `.env` is gitignored, this example is not, so nothing credential-shaped is
# ever committed.
#
# The file is read once at startup and only supplements the environment: any
# name the process already exported wins over the same name here, so a
# container or a scheduler is never overridden by a file lying beside the run.
# Everything here can equally be exported by hand; the file adds no setting of
# its own.

# --- Datadog -----------------------------------------------------------------
# Under Datadog's own variable names, so an operator who already exports these
# for the CLI exports nothing new.

# MANDATORY. API key for the Datadog account the alerts live in.
DD_API_KEY=

# MANDATORY. Application key; the Events API needs both.
DD_APP_KEY=

# Optional. The Datadog site to reach. Defaults to datadoghq.com.
#DD_SITE=datadoghq.eu

# Optional. Where this account's web app is served, if not from `app`. Only
# ever the host a link sends a human to; the API and MCP hosts are unaffected.
#DD_WEB_SUBDOMAIN=foobar

# --- The model an investigation reasons on -----------------------------------
# Under the Google GenAI SDK's own variable names. Which model is used is
# behavior and belongs in `config.yaml`; what it costs to reach is here.
# A run refuses to start without one of these, rather than spending an
# investigation attempt to discover it cannot reason.

# MANDATORY. API key for the model configured under `investigation.model`.
# GEMINI_API_KEY is accepted under the same terms if you already export it.
GOOGLE_API_KEY=

# Optional. Set to `true` to authenticate against the enterprise platform
# instead, with the credentials this deployment already holds; no API key is
# then required.
#GOOGLE_GENAI_USE_ENTERPRISE=true

# Optional, and only on the enterprise platform. The project investigations
# are billed to and the location they are made in. Left unset, the platform's
# own credential discovery names the project and the SDK defaults the location.
#GOOGLE_CLOUD_PROJECT=triage-prod
#GOOGLE_CLOUD_LOCATION=europe-west4

# Note. Everything above is read from this file as though it had been exported.
# GOOGLE_APPLICATION_CREDENTIALS is the exception: it is read by the Google
# auth library straight from the process environment, before this file is
# consulted, so a service-account path set here is not found. Export that one,
# or authenticate with `gcloud auth application-default login`.

# --- The triage ledger -------------------------------------------------------

# Optional. Where the SQLite ledger keeps its records; created on first use.
# Defaults to `data/alert_triage.db` under the working directory, directory
# included and created on first use — set it explicitly
# for anything but a quick local run, or a run started from another directory
# starts from an empty ledger and re-reports everything.
#ALERT_TRIAGE_LEDGER_PATH=/var/lib/alert-triage/ledger.db

# --- Notification channels ---------------------------------------------------
# Configure at least one channel, or the run refuses to start.

# Email. The host activates the channel; the sender and the recipients are then
# required, and a half-configured channel is an error rather than a silent skip.

# Optional. Hostname of the SMTP submission server. Setting it activates the
# email channel and makes ALERT_TRIAGE_EMAIL_FROM and _TO mandatory.
#ALERT_TRIAGE_SMTP_HOST=smtp.example.com

# Mandatory once the host is set. Address every report is sent from.
#ALERT_TRIAGE_EMAIL_FROM=triage@example.com

# Mandatory once the host is set. Comma-separated addresses reports are sent to.
#ALERT_TRIAGE_EMAIL_TO=sre@example.com,oncall@example.com

# Optional. Submission port. Defaults to 587, where STARTTLS is expected.
#ALERT_TRIAGE_SMTP_PORT=587

# Optional. Account to authenticate as; paired with the password, and one
# without the other is a configuration error rather than an unauthenticated
# send. A password is never sent over a connection that stayed in the clear.
#ALERT_TRIAGE_SMTP_USERNAME=triage
#ALERT_TRIAGE_SMTP_PASSWORD=

# Microsoft Teams. One variable, which both names the destination and
# authorises posting to it.

# Optional. Power Automate Workflows webhook URL. Setting it activates the
# Teams channel.
#ALERT_TRIAGE_TEAMS_WEBHOOK_URL=https://prod-1.westeurope.logic.azure.com/...

# --- Behavior overrides ------------------------------------------------------
# Every key in `config.yaml` can also be set here, by mapping its `section.key`
# path to `SECTION_KEY`. The environment wins over the file. See
# `config.example.yaml` for what each one means and what it defaults to; these
# are all optional, except SCOPE_OWNER when `config.yaml` does not set it.

#SCOPE_OWNER=sre
#GROUPING_WINDOW_SECONDS=1800
#INGESTION_LOOKBACK_SECONDS=3600
#INGESTION_REQUEST_TIMEOUT_SECONDS=30
#INGESTION_MAX_RETRIES=3
#RE_NOTIFY_COOLDOWN_SECONDS=172800
#LEDGER_RETENTION_SECONDS=2592000
#INVESTIGATION_MODEL=gemini-2.5-flash
#INVESTIGATION_MAX_ATTEMPTS=3
#CIRCUIT_BREAKERS_MAX_TOOL_CALLS_PER_AGENT=8
#CIRCUIT_BREAKERS_MAX_AGENT_HOPS=2
#CIRCUIT_BREAKERS_MAX_INVESTIGATION_DURATION_SECONDS=300
#CIRCUIT_BREAKERS_MAX_MCP_RETRIES=3
#CIRCUIT_BREAKERS_MCP_CALL_TIMEOUT_SECONDS=30

# A specialist's model override must be declared in `config.yaml`; the
# environment can only adjust one the file already declares.
#INVESTIGATION_SPECIALISTS_TRACE_SPECIALIST_MODEL=gemini-2.5-pro

# A critical service must be declared in `config.yaml`; the environment can
# only adjust one the file already declares.
#CRITICAL_SERVICES_CHECKOUT_TIER=critical
#CRITICAL_SERVICES_CHECKOUT_LATENCY_THRESHOLD_MS=2000
